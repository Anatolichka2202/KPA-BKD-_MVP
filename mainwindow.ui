            <property name="styleSheet">
             <string notr="true">/* Базовый стиль (не выбрано) */
QPushButton {
    background-color: #A0A0A0;  /* Серый */
    border-radius: 10px;
    border: 2px solid black;
    font-weight: bold;
}

/* Состояние: выбрано */
QPushButton:checked {
    background-color: #0000FF;  /* Синий */
}

/* Состояние: наведение */
QPushButton:hover {
    background-color: #C0C0C0;  /* Светло-серый */
}

/* Состояние: выбрано + наведение */
QPushButton:checked:hover {
    background-color: #3333FF;  /* Темно-синий */
}

/* Состояние: отключено */
QPushButton:disabled {
    background-color: #404040;  /* Тёмно-серый */
}</string>
